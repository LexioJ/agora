{
  "template_info": {
    "name": "enterprise_facility_management",
    "version": "1.0.0",
    "description": {
      "en": "Template for enterprise facility management supporting maintenance requests, infrastructure improvements, sustainability initiatives, workspace optimization, and safety concerns with advanced capabilities including voting, hierarchies, and collaborative workflows",
      "fr": "Modèle pour la gestion des installations d'entreprise soutenant les demandes de maintenance, améliorations d'infrastructure, initiatives de durabilité, optimisation de l'espace de travail et préoccupations de sécurité avec des capacités avancées incluant le vote, les hiérarchies et les flux de travail collaboratifs",
      "de": "Vorlage für Unternehmens-Facility-Management zur Unterstützung von Wartungsanfragen, Infrastrukturverbesserungen, Nachhaltigkeitsinitiativen, Arbeitsplatzoptimierung und Sicherheitsbedenken mit erweiterten Funktionen einschließlich Abstimmung, Hierarchien und kollaborativen Arbeitsabläufen",
      "gsw": "Vorlag für Unternehmens-Facility-Management zur Unterstützig vo Wartigs-Aafraage, Infrastruktur-Verbesserige, Nachhaltigkeits-Initiative, Arbeitsplatz-Optimierig und Sicherhäits-Bedenke mit erwiitereti Funktione iischliesslich Abstimmig, Hierarchie und kollaborativi Arbeits-Abläuf"
    },
    "author": "Agora Team",
    "use_case": "enterprise_facilities",
    "available_languages": [
      "en",
      "fr",
      "de",
      "gsw"
    ]
  },
